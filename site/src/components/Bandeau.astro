---
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';


interface Props {
  image: ImageMetadata;
  /** Point de cadrage (object-position), ex. « 70% 10% ». */
  cadrage?: string;
  /** Hauteur liée à la largeur (vw) : `pleine` ≈ 30vw, `demi` ≈ 15vw (comme les maquettes). */
  hauteur?: 'pleine' | 'demi';
  titre?: string;
}

const { image, cadrage = '50% 50%', hauteur = 'pleine', titre } = Astro.props;
---
<section class:list={['banner', { 'banner--half': hauteur === 'demi' }]}>
  <Photo
    src={image}
   
    widths={[640, 960, 1280, 1600, 1920, 2560]}
    sizes="100vw"
    alt=""
    priority
    style={`object-position: ${cadrage}`}
  />
  {titre && <h1>{titre}</h1>}
</section>
